# Example of filling in the .env file

# ===========================================
# Environment
# ===========================================
APP__ENV=development
APP__DOMAIN=localhost

# ===========================================
# Telegram
# ===========================================
TG__WEBHOOK_USE=False
TG__WEBHOOK_PATH=/telegram
TG__BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TG__ADMIN_IDS=[5252216460]
TG__BOT_USERNAME=crv_test_bot
TG__MINIAPP_SHORT_NAME=chamcong

# ===========================================
# WebHook
# ===========================================
WEBHOOK__URL=https://localhost
WEBHOOK__HOST=0.0.0.0
WEBHOOK__PORT=8000
WEBHOOK__SECRET=my_long_and_random_secret_string_for_telegram

# ===========================================
# Database
# ===========================================
DB__HOST=db
DB__PORT=5432
DB__USER=default
DB__PASSWORD=password
DB__NAME=telegram_bot_template

# ===========================================
# Redis
# ===========================================
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__USER=default
REDIS__PASSWORD=password
REDIS__DB=0

# ===========================================
# API Settings (FastAPI for Mini Apps)
# ===========================================
API__HOST=0.0.0.0
API__PORT=8000
API__DEBUG=false

# ===========================================
# WebApp Settings
# ===========================================
WEBAPP__URL=https://your-webapp-domain.com

# Authentication
AUTH__INITDATA_MAX_AGE_SECONDS=3600
AUTH__SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH__DEV_BYPASS=false

# Workshop and business rules
WORKSHOP__LAT=10.000000
WORKSHOP__LNG=106.000000
WORKSHOP__RADIUS_M=100
RULES__GPS_MAX_ACCURACY_M=100
RULES__CHECKIN_CUTOFF=18:00
RULES__REMINDER_AT=18:00
RULES__ESCALATE_AT=18:30
RULES__SWEEP_AT=00:05
RULES__OUTPUT_EDIT_MINUTES=10
RULES__PAY_ROUND_UNIT=1000
RULES__INVITE_EXPIRE_DAYS=7
RULES__MIN_HOURLY_RATE=1000
RULES__MAX_HOURLY_RATE=1000000

# Lark reporting and operations
LARK__SYNC_WEBHOOK_URL=
LARK__SYNC_SECRET=replace-with-random-secret
ALERT__ADMIN_CHAT_ID=0
SEED__MANAGER_NAME=Quan ly
SEED__DIRECTOR_NAME=Giam doc
TZ=Asia/Ho_Chi_Minh
